  },
  "devDependencies": {
    "@remotion/cli": "4.0.484",
    "@types/react": "^18.2.0",
    "pngjs": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.484",
    "typescript": "^5.3.0"
  }
